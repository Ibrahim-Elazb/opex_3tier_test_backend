# Kubernetes Environment Variables
# These values are used in the Kubernetes manifests

# MySQL Root Password (base64 encoded in k8s/secret.yaml)
MYSQL_ROOT_PASSWORD=Ahmed123@

# MySQL Configuration
MYSQL_DATABASE=db
MYSQL_USER=ahmedadmin
MYSQL_PASSWORD=Ahmed123@

# Kubernetes Service Names (internal DNS)
MYSQL_HOST=mysql-service
BACKEND_SERVICE=backend-service
FRONTEND_SERVICE=frontend-service

# Application Configuration
NODE_ENV=production

# Frontend API URL (for Kubernetes internal communication)
NEXT_PUBLIC_API_URL=http://backend-service:3000

# Namespace
K8S_NAMESPACE=opex-app

# Storage
MYSQL_STORAGE_SIZE=5Gi

# Replica Counts
BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
MYSQL_REPLICAS=1
